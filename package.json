{
  "name": "grafana-dash-gen",
  "version": "4.1.1",
  "description": "A grafana dashboard generator",
  "type": "module",
  "main": "grafana/index.js",
  "types": "grafana/index.d.ts",
  "exports": {
    ".": "./grafana/index.js"
  },
  "scripts": {
    "fast-test": "jest",
    "test-cover": "jest --coverage",
    "view-cover": "rm -rf ./coverage && pnpm run test-cover && open ./coverage/index.html",
    "test": "pnpm run fast-test && pnpm run test-cover",
    "lint": "eslint",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublish": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uber/grafana-dash-gen.git"
  },
  "keywords": [
    "grafana",
    "dashboard",
    "generator"
  ],
  "author": "Madan Thangavelu",
  "license": "MIT",
  "dependencies": {
    "error": "^10.4.0",
    "node-fetch": "^2.7.0",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/underscore": "^1.13.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nock": "^14.0.16",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTION.md",
    "LICENSE",
    "README.md",
    "example.js",
    "grafana",
    "src",
    "package.json"
  ],
  "engines": {
    "node": ">=16"
  }
}
